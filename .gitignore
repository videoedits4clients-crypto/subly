# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
# `/build/*` (not `/build`) so the directory itself stays traversable — excluding the directory
# entry outright would make the negation below ineffective (git won't re-include a file whose
# PARENT DIRECTORY is excluded, only a file matched by its own pattern). `build/icon.svg` is the
# actual app-icon source used by electron-builder (package.json's build.win.icon), a real,
# necessary source file, not build output — the bare `/build` rule is generic create-next-app
# boilerplate that would otherwise silently exclude it.
/build/*
!/build/icon.svg

# misc
.DS_Store
*.pem

# Claude Code session-local tooling config (dev-server launch config, scheduler lock file) —
# agent-session tooling, not SUBLY product source.
/.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database — generic patterns for any SQLite file/sidecar/backup snapshot that shouldn't ship
# (dev DBs, WAL/SHM sidecars, and the ad-hoc "*.db.bak-pre-<task>-qa" snapshots this project's
# own QA workflow creates — see postbuild-standalone.js's matching pattern-based sweep for why
# a fixed filename list isn't enough here), with the one real build asset explicitly kept.
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*
!/prisma/template.db

# Whisper worker build output (python/build-worker.js / `npm run worker:build`) — PyInstaller
# intermediates and the frozen ~350MB whisper-worker.exe itself; regenerated by the build, never
# hand-edited, and far too large for normal git history. The .spec file is also regenerated
# fresh by PyInstaller on every run (see build-worker.js), not hand-maintained.
/python/build/
/python/dist/
/python/*.spec

# local file storage (uploads, extracted audio, exports)
/data/

# ffmpeg tmp
/tmp/

# electron desktop packaging output — MUST not exist when `npm run build` runs:
# Next's standalone-output file tracer has been observed sweeping sibling
# top-level directories (confirmed reproducible with a stale /release* here)
# into .next/standalone, bloating the desktop package with nested copies of
# itself. `npm run clean` / postbuild-standalone.js now match this by PATTERN
# (any /release*/ dir, whatever suffix), not a fixed list — a fixed list once
# missed an ad-hoc release5/release6 used during iteration and let the bloat
# back in. Always `npm run clean` before rebuilding regardless.
/release*/


# The ~480 MB speech model that ships inside the installer (scripts/prepare-model-seed.js, `npm run model:seed`).
/assets/models-seed/
